# AI MOCK INTERVIEW — VIGNAN'S UNIVERSITY
# Backend Environment Configuration Template

# Server & Runtime
PROJECT_NAME="AI MOCK INTERVIEW — VIGNAN'S UNIVERSITY"
ENVIRONMENT=production
API_V1_STR=/api/v1

# MongoDB Atlas Database Connection
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=vignan_ai_interview_db

# JWT Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Resend Email Delivery (For Student Registration OTP and Password Reset)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified domain or "onboarding@resend.dev" for testing
EMAIL_FROM=Vignan Mock Interview <onboarding@resend.dev>

# Google Gemini Live API Configuration
# Get from: https://aistudio.google.com/app/apikey
AI_PROVIDER_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gemini-2.0-flash

# Initial Admin Bootstrap Credentials
# IMPORTANT: Provide your actual chosen Admin User ID and Password in Render
# The backend will create this account once on first startup and hash with Argon2id
ADMIN_USERNAME=vignan_admin
ADMIN_INITIAL_PASSWORD=YourStrongInitialPassword2026!

# Allowed Frontend Origins (Comma separated for CORS)
# Add your deployed Vercel frontend URL here
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-frontend-app.vercel.app
